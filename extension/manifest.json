{
  "manifest_version": 3,
  "name": "Visual history by dux",
  "version": "1.0.0",
  "description": "Last year of browsing history grouped by domain, with a preview image and the latest links per domain.",
  "browser_specific_settings": {
    "gecko": {
      "id": "visual-history@dux.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "history",
    "storage",
    "menus",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["shared.js", "background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Visual history by dux",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_area": "navbar"
  },
  "commands": {
    "open-visual-history": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open Visual history by dux"
    }
  }
}
