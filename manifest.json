{
  "manifest_version": 2,
  "name": "Visual history by dux",
  "version": "1.0.0",
  "description": "Last year of browsing history grouped by domain, with a preview image and the latest links per domain.",
  "browser_specific_settings": {
    "gecko": {
      "id": "visual-history@dux.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "alarms",
    "history",
    "storage",
    "menus",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "browser_action": {
    "default_title": "Visual history by dux",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar"
  },
  "commands": {
    "open-visual-history": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open Visual history by dux"
    }
  }
}
